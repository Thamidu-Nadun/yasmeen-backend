{
  "name": "pdf_generation_backend",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "start": "python app.py",
    "prepare": "husky",
    "format": "ruff check . --select I --fix && ruff format .",
    "lint": "ruff check .",
    "semgrep": "semgrep --config=auto"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.15.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "**/*.py": [
      "pnpm run format",
      "pnpm run semgrep"
    ]
  }
}
